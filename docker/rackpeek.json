{
  "name": "RackPeek",
  "repo": "aptacode/rackpeek:latest",
  "registry": "https://hub.docker.com/r/aptacode/rackpeek",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8080]",
  "icon": "https://cdn.jsdelivr.net/gh/selfhst/icons/png/rackpeek.png",
  "category": [ "Utilities" ],
  "project": "https://timmoth.github.io/RackPeek/",
  "support": "https://github.com/Timmoth/RackPeek/issues",
  "donate": null,
  "description": "A webui and CLI tool for documenting and managing home lab and small-scale IT infrastructure. Tracks hardware, services, networks, and their relationships in a clear, scriptable, YAML-based format without enterprise bloat.",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/rackpeek",
      "container": "/app/config",
      "mode": "rw",
      "description": "Stores config.yaml — RackPeek's inventory state.",
      "required": true
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": "Web interface port.",
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}