{
  "name": "Docker Socket Proxy",
  "repo": "tecnativa/docker-socket-proxy:latest",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped -p 127.0.0.1:2375:2375 --read-only --tmpfs /run --tmpfs /tmp --security-opt no-new-privileges:true --memory 64m --pids-limit 100",
  "post_parameters": null,
  "web_ui_url": null,
  "icon": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/docker.png",
  "category": [
    "Security"
  ],
  "project": "https://github.com/Tecnativa/docker-socket-proxy",
  "support": "https://github.com/Tecnativa/docker-socket-proxy/issues",
  "donate": null,
  "description": "Read-only proxy in front of the Docker socket, so monitoring tools (Dozzle, Beszel agent) can read containers, logs and stats without full Docker access. Published on 127.0.0.1:2375 only; POST=0 blocks every write.",
  "readme_url": "https://github.com/Tecnativa/docker-socket-proxy/blob/master/README.md",
  "paths": [
    {
      "name": "Docker Socket",
      "host": "/var/run/docker.sock",
      "container": "/var/run/docker.sock",
      "mode": "ro",
      "description": "Docker socket. ':ro' restricts nothing on a socket; POST=0 below is what makes the API read-only.",
      "required": true
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "Containers",
      "key": "CONTAINERS",
      "value": "1",
      "description": "Allow container list/inspect/logs/stats (needed by Dozzle and the Beszel agent).",
      "required": true,
      "mask": false
    },
    {
      "name": "Info",
      "key": "INFO",
      "value": "1",
      "description": "Allow /info.",
      "required": true,
      "mask": false
    },
    {
      "name": "Events",
      "key": "EVENTS",
      "value": "1",
      "description": "Allow /events (Dozzle follows container starts/stops).",
      "required": true,
      "mask": false
    },
    {
      "name": "POST",
      "key": "POST",
      "value": "0",
      "description": "Block all POST/PUT/DELETE requests: keep at 0, this is what makes the proxy read-only.",
      "required": true,
      "mask": false
    }
  ],
  "devices": [],
  "labels": []
}
